{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "deltecho-chat-preview",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2024-12-01",

  // Enable observability for container logs
  "observability": {
    "enabled": true
  },

  // Container configuration
  // Dockerfile is at repo root, path is relative to this wrangler.jsonc file
  "containers": [
    {
      "class_name": "DeltEchoApp",
      "image": "../../Dockerfile.cloudflare",
      "max_instances": 10,
      // Use immediate rollout to avoid gradual rollout issues
      "rollout_step_percentage": [100]
    }
  ],

  // Durable Objects binding for containers
  "durable_objects": {
    "bindings": [
      {
        "name": "DELTECHO_CONTAINER",
        "class_name": "DeltEchoApp"
      }
    ]
  },

  // Preserve the production namespace lineage already deployed on Cloudflare:
  // DeltEchoContainer was created at v1 and renamed to DeltEchoApp at v2.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeltEchoContainer"]
    },
    {
      "tag": "v2",
      "renamed_classes": [
        {
          "from": "DeltEchoContainer",
          "to": "DeltEchoApp"
        }
      ]
    }
  ],

  // Environment variables (secrets should be set via wrangler secret)
  "vars": {
    "ENVIRONMENT": "preview"
  },

  // The preview Worker already owns a v1 DeltEchoApp namespace. Bind it
  // explicitly instead of replaying the production rename into that namespace.
  "env": {
    "preview": {
      "containers": [
        {
          "class_name": "DeltEchoApp",
          "image": "../../Dockerfile.cloudflare",
          "max_instances": 10,
          "rollout_step_percentage": [100]
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "DELTECHO_CONTAINER",
            "class_name": "DeltEchoApp"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["DeltEchoApp"]
        }
      ],
      "vars": {
        "ENVIRONMENT": "preview"
      }
    }
  },

  // Development settings
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  }
}
