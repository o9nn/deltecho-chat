# Aphroditecho-home (CogHood) local-LLM mode
# To enable, copy this file to .env.local before running pnpm build:browser
#   cp packages/frontend/.env.aphroditecho packages/frontend/.env.local
#
# These values default to the Aion llama-server already running on the
# CogHood persistent VM. If you have stood up the dedicated
# aphroditecho-api FastAPI service (Step 2 of the integration plan),
# point at :8430 instead.

VITE_APHRODITECHO_LLM_URL=http://127.0.0.1:8420/v1/chat/completions
VITE_APHRODITECHO_MODEL=aion.gguf

# To target the dedicated aphroditecho-api service once stood up:
# VITE_APHRODITECHO_LLM_URL=http://127.0.0.1:8430/v1/chat/completions
# VITE_APHRODITECHO_MODEL=deeptreeecho
