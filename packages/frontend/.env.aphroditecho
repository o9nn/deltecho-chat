# Aphroditecho-home (CogHood) local-LLM mode
#
# Activation:
#   cp packages/frontend/.env.aphroditecho packages/frontend/.env.local
#   pnpm build:browser
#
# The chat UI talks to the aphroditecho-api FastAPI gateway, which
#   - injects the Deep Tree Echo persona prompt
#   - records each turn into the dove9 memory bridge
#   - forwards to the local Aion llama-server (port 8420)
#
# We use a SAME-ORIGIN relative URL so the chat UI works behind any
# reverse proxy (nginx on port 8090 in production) without CSP
# friction: `connect-src 'self'` already permits relative URLs, and
# we never leak the upstream port to the user's browser. The
# deployment proxies `/aphroditecho/` -> `http://127.0.0.1:8431/`.
# For pure-loopback dev (no reverse proxy), set this to
# http://localhost:8431/v1/chat/completions instead.

VITE_APHRODITECHO_LLM_URL=/aphroditecho/v1/chat/completions
VITE_APHRODITECHO_MODEL=aion.gguf

# To bypass the gateway and hit the raw llama-server directly (skips persona
# injection and memory recording), uncomment:
# VITE_APHRODITECHO_LLM_URL=http://localhost:8420/v1/chat/completions
