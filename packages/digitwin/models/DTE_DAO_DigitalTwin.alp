<AnyLogicWorkspace WorkspaceVersion="1.9" AnyLogicVersion="8.9.9.202607020720" AlpVersion="8.9.9">
<Model>
	<Id>1700000000001</Id>
	<Name><![CDATA[DTE_DAO_DigitalTwin]]></Name>
	<Description><![CDATA[Deep Tree Echo DAO Digital Twin - A multi-method simulation of an AGI cognitive architecture modeled as a Decentralized Autonomous Organization with Echo State Network Autognosis. The model combines System Dynamics (16-hormone virtual endocrine system with 32 flows and 6 feedback loops), Discrete Event Simulation (6-stage cognitive pipeline processing entities through attention, perception, reservoir, readout, DAO voting, and action), and Agent-Based Modeling (256 reservoir nodes, 7 DAO voters, and 1 autognosis agent with statecharts). Cross-paradigm bridges connect all three methods bidirectionally.]]></Description>
	<EngineVersion>6</EngineVersion>
	<JavaPackageName><![CDATA[dte_dao_digitwin]]></JavaPackageName>
	<ModelTimeUnit><![CDATA[Second]]></ModelTimeUnit>
	<Folders>
	</Folders>
