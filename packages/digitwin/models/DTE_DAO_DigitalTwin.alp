							<Code><![CDATA[0.5]]></Code>
						</InitialValue>
					</Properties>
				</Variable>
			</Variables>
			<Functions>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURN</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1700002200001</Id>
					<Name><![CDATA[evaluate]]></Name>
					<X>200</X><Y>30</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[coherence]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[cortisol]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[dopamine]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[serotonin]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Role-specific evaluation with hormone modulation
double vote = 0.5;
switch (role) {
    case "risk":
        vote = 1.0 - cortisol; // High cortisol = reject risky proposals
        break;
    case "opportunity":
        vote = dopamine; // High dopamine = approve exploratory proposals
        break;
    case "coherence":
        vote = coherence; // Direct coherence signal
        break;
    case "resource":
        vote = serotonin * 0.7 + 0.3; // Serotonin = resource confidence
        break;
    case "temporal":
        vote = 0.5 + (dopamine - cortisol) * 0.3; // Balance urgency vs caution
        break;
    case "social":
        vote = serotonin * 0.5 + coherence * 0.5; // Social = stability + coherence
        break;
    case "self_preservation":
        vote = (1.0 - cortisol) * coherence; // Preserve only when safe + coherent
        break;
}
// Apply bias and clamp
lastVote = Math.max(0, Math.min(1, vote + bias));
return lastVote;]]></Body>
				</Function>
			</Functions>
