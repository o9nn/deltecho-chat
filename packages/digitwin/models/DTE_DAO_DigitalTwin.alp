			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1700000600001</Id>
					<Name><![CDATA[initializeReservoir]]></Name>
					<X>-200</X><Y>50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Initialize 256 reservoir nodes with random weights
for (ReservoirNode node : reservoirNodes) {
    node.activation = uniform(-0.1, 0.1);
    node.leakRate = uniform(0.1, 0.9);
    node.bias = uniform(-0.5, 0.5);
}
spectralRadius = 0.95;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1700000600002</Id>
					<Name><![CDATA[initializeEndocrineSystem]]></Name>
					<X>-200</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Set initial hormone levels to homeostatic baseline
stressSignal = 0.3;
rewardSignal = 0.5;
coherenceSignal = 0.6;
cognitiveMode = "BALANCED";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1700000600003</Id>
					<Name><![CDATA[initializeDAOVoters]]></Name>
					<X>-200</X><Y>150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Initialize 7 DAO voters with role-specific stakes
String[] roles = {"risk", "opportunity", "coherence", "resource", "temporal", "social", "self_preservation"};
double[] stakes = {0.15, 0.20, 0.25, 0.10, 0.10, 0.10, 0.10};
int i = 0;
for (DAOVoter voter : daoVoters) {
    voter.role = roles[i];
    voter.stake = stakes[i];
    voter.bias = 0.0;
    i++;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURN</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1700000600004</Id>
					<Name><![CDATA[computeReservoirCoherence]]></Name>
					<X>-200</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Compute mean absolute activation as coherence proxy
double sum = 0;
for (ReservoirNode node : reservoirNodes) {
    sum += Math.abs(node.activation);
}
double meanAct = sum / reservoirNodes.size();
// Coherence is high when activation is moderate (edge of chaos)
return 1.0 - Math.abs(meanAct - 0.5) * 2.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURN</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1700000600005</Id>
					<Name><![CDATA[computeCognitiveMode]]></Name>
					<X>-200</X><Y>250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Nearest-centroid mode detection in hormone space
double[] state = {cortisol, dopamine, serotonin, norepinephrine, oxytocin, 
                  thyroxine, melatonin, insulin, adrenaline, endorphin};
// Mode centroids (simplified)
if (dopamine > 0.7 && serotonin > 0.6) return "FLOW";
if (cortisol > 0.7 && adrenaline > 0.6) return "FIGHT_OR_FLIGHT";
if (serotonin > 0.7 && oxytocin > 0.6) return "SOCIAL_BONDING";
if (melatonin > 0.7 && gaba > 0.6) return "REST_DIGEST";
if (norepinephrine > 0.7 && acetylcholine > 0.6) return "FOCUSED_ATTENTION";
if (dopamine > 0.6 && norepinephrine > 0.5) return "CREATIVE_EXPLORATION";
if (cortisol > 0.5 && substance_p > 0.5) return "DISTRESS";
if (endorphin > 0.6 && anandamide > 0.5) return "EUPHORIA";
return "BALANCED";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURN</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1700000600006</Id>
					<Name><![CDATA[computeDAOConsensus]]></Name>
					<X>-200</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Stake-weighted consensus from all 7 voters
double weightedSum = 0;
double totalStake = 0;
for (DAOVoter voter : daoVoters) {
    double vote = voter.evaluate(globalCoherence, cortisol, dopamine, serotonin);
    weightedSum += vote * voter.stake;
    totalStake += voter.stake;
}
return weightedSum / totalStake;]]></Body>
				</Function>
			</Functions>
